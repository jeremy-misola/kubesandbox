   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 6,
    "y": 27
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (source) (rate(kubesandbox_sandbox_claimed_total[$__rate_interval]))",
