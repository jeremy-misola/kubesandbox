   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 18,
    "y": 27
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(kubesandbox_sandbox_provision_duration_seconds_bucket[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(kubesandbox_sandbox_provision_duration_seconds_bucket[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
