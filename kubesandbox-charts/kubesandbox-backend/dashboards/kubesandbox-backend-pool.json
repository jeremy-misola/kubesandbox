{
 "uid": "kubesandbox-backend-pool",
 "title": "KubeSandbox \u2014 Backend & Pool",
 "tags": [
  "kubesandbox",
  "backend",
  "pool"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Datasource",
    "current": {
     "text": "Mimir",
     "value": "Mimir"
    }
   },
   {
    "name": "job",
    "type": "constant",
    "query": "kubesandbox-backend",
    "current": {
     "text": "kubesandbox-backend",
     "value": "kubesandbox-backend"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "API & load",
   "collapsed": false,
   "id": 1,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "timeseries",
   "title": "Request rate",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "req/s"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Request rate by route",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{http_route}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "5xx error ratio",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"$job\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"$job\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "5xx ratio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Request latency (p50/p95/p99)",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\"}[$__rate_interval])))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "timeseries",
   "title": "POST /api/sessions outcomes",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$job\",http_route=\"/api/sessions\",http_request_method=\"POST\"}[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "{{http_response_status_code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "201 = assigned from warm pool, 202 = queued, 409 = duplicate"
  },
  {
   "type": "timeseries",
   "title": "In-flight requests",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(http_server_active_requests{job=\"$job\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "in-flight"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Sandbox pool state",
   "collapsed": false,
   "id": 8,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   }
  },
  {
   "type": "stat",
   "title": "Pool state (now)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kubesandbox_pool_warm_available",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "available"
    },
    {
     "refId": "B",
     "expr": "kubesandbox_pool_warm_pending",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "pending"
    },
    {
     "refId": "C",
     "expr": "kubesandbox_pool_claimed",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "claimed"
    },
    {
     "refId": "D",
     "expr": "kubesandbox_pool_total",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "total"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "type": "timeseries",
   "title": "Pool state over time",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kubesandbox_pool_warm_available",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "available"
    },
    {
     "refId": "B",
     "expr": "kubesandbox_pool_warm_pending",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "pending"
    },
    {
     "refId": "C",
     "expr": "kubesandbox_pool_claimed",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "claimed"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 35,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "description": "Warm health cue: available should sit at kubesandbox_pool_target"
  },
  {
   "type": "timeseries",
   "title": "Capacity headroom",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 18
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kubesandbox_pool_total / kubesandbox_pool_capacity_max",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "total / max"
    },
    {
     "refId": "B",
     "expr": "kubesandbox_pool_warm_available < on() kubesandbox_pool_target",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "warm below target"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "type": "row",
   "title": "Provisioning & claim throughput",
   "collapsed": false,
   "id": 12,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 26
   }
  },
  {
   "type": "timeseries",
