   }
  },
  {
   "type": "timeseries",
   "title": "Recycled / expired",
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 27
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(kubesandbox_sandbox_recycled_total[$__rate_interval]))",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "legendFormat": "recycled: {{reason}}"
