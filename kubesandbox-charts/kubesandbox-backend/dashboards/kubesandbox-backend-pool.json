  },
  {
   "type": "timeseries",
   "title": "Pool-empty rate",
   "id": 20,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
