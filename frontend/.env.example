# Local dev config. Copy to .env.local and adjust.
# In production these are injected at runtime via /config.js (see docker-entrypoint.sh),
# NOT baked into the bundle.

# Control API base path (gateway routes this to the backend). Backend serves /api.
VITE_API_BASE=/api

# Origin used to build the terminal hand-off URL: ${VITE_PUBLIC_BASE_URL}/s/{id}
VITE_PUBLIC_BASE_URL=https://kubesandbox.com

# Authentik OIDC (frontend public client)
VITE_OIDC_ISSUER=https://auth.jeremymr.dev/application/o/kubesandbox-frontend/
VITE_OIDC_CLIENT_ID=kubesandbox-frontend
VITE_OIDC_REDIRECT_URI=https://kubesandbox.com/auth/callback

# Local dev only: where `vite dev` proxies /api (defaults to http://localhost:8080)
# VITE_DEV_PROXY_TARGET=http://localhost:8080
